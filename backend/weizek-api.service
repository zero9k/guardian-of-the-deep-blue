[Unit]
Description=Weizek Ocean AI Visual Gateway
After=network-online.target
[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/weizek-api
EnvironmentFile=-/etc/weizek-api.env
ExecStart=/usr/bin/python3 /opt/weizek-api/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
